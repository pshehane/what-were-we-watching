# Normalise to LF in the repository so a Windows checkout does not show every
# file as modified. Working copies still get native endings.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they will not run.
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# Unix launcher must keep LF and stay executable.
gradlew text eol=lf

# Binary: never touch these.
*.ttf   binary
*.otf   binary
*.jar   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.apk   binary
*.keystore binary
*.jks   binary
